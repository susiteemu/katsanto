{
	"name": "katsanto-web",
	"private": true,
	"version": "0.0.1",
	"author": "Teemu Turunen",
	"repository": "github:susiteemu/katsanto",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"api": "cd .. && cargo run -q -p katsanto-server -- openapi > web/src/lib/api/openapi.json && cd web && npx -y openapi-typescript@7 src/lib/api/openapi.json -o src/lib/api/schema.d.ts --empty-objects-unknown && prettier --write src/lib/api/schema.d.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.6.5",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@simplewebauthn/browser": "^14.0.0",
		"@videojs/dash-video": "10.2.0",
		"@videojs/html": "10.2.0",
		"openapi-fetch": "^0.17.0"
	}
}
